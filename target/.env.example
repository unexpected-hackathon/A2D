# 복사해서 쓴다: cp .env.example .env  (demo.sh up이 없으면 자동으로 복사한다)

# 시연 도메인과 네트워크
DEMO_DOMAIN=trip.hyki.me
DEMO_SUBNET=10.253.53.0/24
PROXY_IP=10.253.53.80
DNS_IP=10.253.53.53

# 호스트에 여는 포트(127.0.0.1에만 묶인다)
HTTP_PORT=18080
HTTPS_PORT=18443
DNS_PORT=15353
BROWSE_PORT=18888

# FR-01 소유권 확인 TXT 레코드. A2D 등록 화면이 준 값을 넣는다: ./demo.sh verify <값>
A2D_VERIFY_NAME=_a2d-verify
A2D_VERIFY_VALUE=

# 감시 시연: 1이면 test 하위 도메인이 새로 열린다 (./demo.sh test-server on)
SHOW_TEST_SERVER=0

# 결함 토글: 0 = 결함 있음(기본), 1 = 고친 상태. 번호는 docs/A2D_점검점수설계.md의 #번호.
FIX_6=0
FIX_8=0
FIX_9=0
FIX_10=0
FIX_11=0
FIX_12=0
FIX_13=0
FIX_14=0
FIX_16=0
FIX_17=0
FIX_18=0
FIX_19=0
FIX_20=0
FIX_21=0
FIX_23=0
FIX_25=0
FIX_27=0
FIX_28=0
