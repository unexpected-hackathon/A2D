# 복사해서 쓴다: cp .env.example .env  (.env는 커밋하지 않는다)

# 시연용 단일 계정 (API 명세 3장). 서버를 띄울 때 이 값으로 계정을 만든다
A2D_ADMIN_EMAIL=
A2D_ADMIN_PASSWORD=
A2D_ADMIN_NAME=IT 담당자

# A2D 화면 주소(쉼표로 여러 개). POST·PATCH의 Origin이 여기에 없으면 403 FORBIDDEN_ORIGIN
A2D_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# HTTPS로 띄울 때만 1 (쿠키에 Secure)
A2D_SECURE_COOKIE=0
# 1이면 /api/v1/openapi.json·/api/v1/docs를 연다. 시연 환경 밖에서는 0 (#17)
A2D_EXPOSE_OPENAPI=0
A2D_DB_PATH=data/a2d.sqlite3

# 소유권 확인(FR-01): dns = TXT 조회, trust = 조회 없이 통과(화면 개발용. 시연에서는 dns)
A2D_VERIFY_MODE=dns
# 비우면 시스템 DNS. 시연 DNS: 컨테이너 안이면 10.253.53.53, 노트북에서 직접 띄우면 127.0.0.1:15353
A2D_DNS_SERVER=

# 점검 엔진: fixture = 시연 시나리오 가짜 엔진(네트워크 요청 없음), 또는 패키지.모듈:클래스
A2D_ENGINE=fixture
A2D_FIXTURE_STEP_SEC=0.4
A2D_REQUEST_LIMIT=300
A2D_TOOL_CALL_LIMIT=20
A2D_TIME_LIMIT_SEC=300

# LLM: GPU 서버 vLLM(OpenAI 호환) 주소. 비우면 llm=down, 기본 가이드로 동작
A2D_LLM_BASE_URL=
A2D_LLM_API_KEY=
A2D_LLM_MODEL=Qwen/Qwen3-8B
