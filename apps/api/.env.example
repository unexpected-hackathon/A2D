# 복사해서 쓴다: cp .env.example .env  (.env는 커밋하지 않는다)

# docker compose가 읽을 파일. 기본은 시연 대상(target)과 함께(target을 먼저 띄운다).
# 실제 도메인만 점검하고 target 없이 띄우려면 compose.yml만 남긴다: COMPOSE_FILE=compose.yml
COMPOSE_FILE=compose.yml:compose.demo.yml
COMPOSE_PATH_SEPARATOR=:

# 시연용 단일 계정 (API 명세 3장). 서버를 띄울 때 이 값으로 계정을 만든다
A2D_ADMIN_EMAIL=
A2D_ADMIN_PASSWORD=
A2D_ADMIN_NAME=IT 담당자

# A2D 화면을 연 주소(포트 포함)를 그대로 넣는다. 쉼표로 여러 개. 5173 = vite dev, 4173 = vite preview
# Origin이 여기에 없으면 로그인을 포함한 모든 POST·PATCH가 403 FORBIDDEN_ORIGIN이다
A2D_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# HTTPS로 띄울 때만 1 (쿠키에 Secure)
A2D_SECURE_COOKIE=0
# 1이면 /api/v1/openapi.json·/api/v1/docs를 연다. 시연 환경 밖에서는 0 (#17)
A2D_EXPOSE_OPENAPI=0
A2D_DB_PATH=data/a2d.sqlite3

# 소유권 확인(FR-01): dns = TXT 조회, trust = .test 같은 예약 도메인만 조회 없이 통과(화면 개발용)
# trust여도 실제 도메인은 TXT로 확인한다. 실제 점검 엔진이 소유권 없는 사이트를 점검하지 않게 하려는 것이다
# 시연 중에는 루트에서 ./a2d-demo.sh txt-check on|off 로 바꾼다
A2D_VERIFY_MODE=dns
# trust에서 예약 도메인처럼 TXT 없이 통과시킬 실제 도메인. 쉼표로 여러 개, 하위 도메인 포함. 직접 소유한 도메인만 넣는다
A2D_TRUST_DOMAINS=
# 점검 DNS. 소유권 확인·자산 찾기와 점검 접속(HTTP·TLS)이 모두 이 DNS로 주소를 찾는다. 비우면 시스템 DNS
# 노트북에서 uvicorn으로 직접 띄울 때 시연 DNS는 127.0.0.1:15353. 이때 점검은 시연 DNS가 주는
# 컨테이너 주소(10.253.53.80:443)로 접속하므로 그 주소에 닿는 Linux에서만 된다(macOS·Windows는 compose로 띄운다)
# compose.demo.yml을 얹어 띄우면 이 값은 무시하고 시연 DNS 10.253.53.53을 쓴다(바꾸려면 A2D_DEMO_DNS_IP)
A2D_DNS_SERVER=

# 점검 엔진: 기본은 실제 대상을 읽기만 해서 점검하는 LiveEngine
# fixture = 시연 시나리오를 돌려주는 가짜 엔진(네트워크 요청 없음, 오프라인 대비용)
A2D_ENGINE=a2d.engine.live:LiveEngine
A2D_FIXTURE_STEP_SEC=0.4
A2D_REQUEST_LIMIT=300
A2D_TOOL_CALL_LIMIT=20
A2D_TIME_LIMIT_SEC=300

# LLM: GPU 서버 vLLM(OpenAI 호환) 주소. 비우면 llm=down, 기본 가이드로 동작
A2D_LLM_BASE_URL=
A2D_LLM_API_KEY=
A2D_LLM_MODEL=qwen3-8b
