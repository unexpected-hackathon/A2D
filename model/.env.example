# 복사해서 쓴다: cp .env.example .env  (llm.sh가 없으면 자동으로 복사한다)
# 이 파일에는 키 이름과 기본값만 둔다. 서버 주소·계정·비밀번호·API 키 값은 .env에만 적고 커밋하지 않는다.

# ── GPU 서버에서 쓰는 값 ─────────────────────────────────────────────

# 모델. revision은 Hugging Face 커밋 해시로 고정한다(README 외부 자원 표와 같게 둔다).
MODEL_ID=Qwen/Qwen3-8B
MODEL_REVISION=b968826d9c46dd6066d109eabc6255188de91218
# 가중치를 내려받을 위치(약 16GB). 저장소 밖 홈 디렉터리에 둔다.
MODEL_DIR=$HOME/models/Qwen3-8B

# vLLM 버전. 바꾸면 README 외부 자원 표도 고친다.
VLLM_VERSION=0.31.0
PYTHON_VERSION=3.12
# 가상 환경·패키지 설치 도구. 바꾸면 README 외부 자원 표도 고친다.
UV_VERSION=0.13.6

# 서버 설정. HOST는 127.0.0.1로 둔다. 외부에서는 SSH 터널로만 붙는다(포트 개방 금지).
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
# 백엔드가 요청에 넣는 모델 이름
SERVED_MODEL_NAME=qwen3-8b
# 요청마다 Authorization: Bearer <키>로 보낸다. 비워 두면 llm.sh up이 무작위 값을 만들어 .env에 적는다.
VLLM_API_KEY=

# 메모리. L4(23GB)에 BF16 가중치가 약 16GB를 차지한다. OOM이면 MAX_MODEL_LEN을 먼저 줄인다.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=8

# Qwen3 생각 모드 기본값. false면 <think> 없이 바로 답한다(지연 시간 단축).
# 요청마다 chat_template_kwargs로 바꿀 수 있다.
ENABLE_THINKING=false

# 가중치를 받을 때만 필요할 수 있다(Qwen3-8B는 공개 모델이라 보통 비워 둔다).
HF_TOKEN=

# ── 내 PC에서 터널을 열 때 쓰는 값 (llm.sh tunnel) ─────────────────────

# 운영진이 준 GPU 서버 사설 IP, SSH 포트, 계정. 값은 커밋하지 않는다.
GPU_SSH_HOST=
GPU_SSH_PORT=22
GPU_SSH_USER=
# 내 PC에서 열 포트. 백엔드 LLM_BASE_URL=http://127.0.0.1:<이 값>/v1
LOCAL_PORT=8000
